# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local changes
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Private keys / credentials
*.pem
*.key
.env
.env.*

# OS / editor
.DS_Store
.qodo/

# Large / unrelated local files
*.dmg
*.docx
*.xlsx
*.jpg
*.jpeg
*.png
*.tex
